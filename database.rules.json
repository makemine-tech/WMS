{
  "rules": {
    "warehouses": {
      "$wid": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userWarehouse/'+auth.uid).val() === $wid || (root.child('userGroup/'+auth.uid).exists() && root.child('groups/'+root.child('userGroup/'+auth.uid).val()+'/'+$wid).exists()))",
        ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userWarehouse/'+auth.uid).val() === $wid || (root.child('userGroup/'+auth.uid).exists() && root.child('groups/'+root.child('userGroup/'+auth.uid).val()+'/'+$wid).exists()))",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "txLogs": {
      "$wid": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userWarehouse/'+auth.uid).val() === $wid || (root.child('userGroup/'+auth.uid).exists() && root.child('groups/'+root.child('userGroup/'+auth.uid).val()+'/'+$wid).exists()))",
        ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userWarehouse/'+auth.uid).val() === $wid || (root.child('userGroup/'+auth.uid).exists() && root.child('groups/'+root.child('userGroup/'+auth.uid).val()+'/'+$wid).exists()))"
      }
    },
    "voiceDiag": {
      "$wid": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userWarehouse/'+auth.uid).val() === $wid || (root.child('userGroup/'+auth.uid).exists() && root.child('groups/'+root.child('userGroup/'+auth.uid).val()+'/'+$wid).exists()))",
        ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userWarehouse/'+auth.uid).val() === $wid || (root.child('userGroup/'+auth.uid).exists() && root.child('groups/'+root.child('userGroup/'+auth.uid).val()+'/'+$wid).exists()))"
      }
    },
    "warehouseIndex": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userWarehouse": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userGroup": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('superadmins/'+auth.uid).exists())"
      }
    },
    "groups": {
      ".read": "auth != null && root.child('superadmins/'+auth.uid).exists()",
      "$gid": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
        ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()"
      }
    },
    "inviteCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },
    "notices": {
      "$gid": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
        ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)"
      }
    },
    "notice": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "superadmins": {
      ".read": "auth != null",
      ".write": false
    },
    "pageAccess": {
      ".read": true,
      ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()"
    },
    "vendorConfig": {
      "$gid": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
        ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()"
      }
    },
    "vendorByEmail": {
      "$ekey": {
        ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || (auth.token.email != null && auth.token.email.toLowerCase().replace('.',',') === $ekey))",
        ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()"
      }
    },
    "vendorStatus": {
      "$gid": {
        ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
        "$vid": {
          ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid || (auth.token.email != null && root.child('vendorByEmail/'+auth.token.email.toLowerCase().replace('.',',')+'/gid').val() === $gid && root.child('vendorByEmail/'+auth.token.email.toLowerCase().replace('.',',')+'/vendorId').val() === $vid))"
        }
      }
    },
    "vendorLoose": {
      "$gid": {
        ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
        "$vid": {
          ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid || (auth.token.email != null && root.child('vendorByEmail/'+auth.token.email.toLowerCase().replace('.',',')+'/gid').val() === $gid && root.child('vendorByEmail/'+auth.token.email.toLowerCase().replace('.',',')+'/vendorId').val() === $vid))"
        }
      }
    },
    "wms_sync": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "groups": {
        "$gid": {
          ".read": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
          ".write": "auth != null && (root.child('superadmins/'+auth.uid).exists() || root.child('userGroup/'+auth.uid).val() === $gid)",
          "picktalk": {
            "logs": {
              ".indexOn": [
                "dateInt"
              ]
            }
          },
          "cargo": {
            "logs": {
              ".indexOn": [
                "date"
              ]
            }
          }
        }
      }
    },
    "payroll": {
      ".read": "auth != null && root.child('superadmins/'+auth.uid).exists()",
      ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()",
      "audit": {
        ".indexOn": [
          "t"
        ]
      }
    },
    "stats": {
      ".read": "auth != null && root.child('superadmins/'+auth.uid).exists()",
      ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()",
      "day": {
        "$day": {
          ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$page": {
            ".validate": "$page.matches(/^[A-Za-z0-9_-]{1,40}$/)",
            "v": {
              ".write": true,
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            },
            "m": {
              ".write": true,
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            },
            "h": {
              "$hh": {
                ".write": true,
                ".validate": "$hh.matches(/^[0-2][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "uv": {
        "$day": {
          ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$page": {
            ".validate": "$page.matches(/^[A-Za-z0-9_-]{1,40}$/)",
            "$vid": {
              ".write": "!data.exists()",
              ".validate": "newData.val() === true && $vid.matches(/^[a-z0-9]{6,20}$/)"
            }
          }
        }
      },
      "log": {
        "$day": {
          ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['p','t','u']) && newData.child('u').val() === auth.uid && newData.child('t').val() === now",
            "p": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/)"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "u": {
              ".validate": "newData.isString()"
            },
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "m": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "settlement": {
      ".read": "auth != null && root.child('superadmins/'+auth.uid).exists()",
      ".write": "auth != null && root.child('superadmins/'+auth.uid).exists()"
    }
  }
}
