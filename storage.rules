rules_version = '2';

// Firebase Storage 보안 규칙 — picking_ez 대용량 PDF 창고용.
// ⚠ 이 파일은 GitHub Actions(호스팅 전용)로는 배포되지 않습니다.
//   Firebase 콘솔 → Storage → Rules 에 붙여넣고 '게시(Publish)' 하거나,
//   개발 PC 에서 `firebase deploy --only storage` 로 배포하세요.
//
// 참고: Storage 규칙은 Realtime Database 의 그룹 정보(userGroup)를 직접 못 읽습니다.
//   그래서 '로그인된 사용자'로 제한하고, 경로에 그룹ID(gid)를 포함해 분리합니다.
//   (같은 그룹끼리만 쓰는 사내 도구 기준의 실용적 수준)
service firebase.storage {
  match /b/{bucket}/o {
    match /picking_ez/{gid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 1024 * 1024 * 1024;  // 최대 1GB (contentType 조건 제거 — 거절 방지)
      allow delete: if request.auth != null;
    }
    // 피킹(star_picking) 여러 날치 세트 — 세트별 원본·정렬 PDF (어느 PC에서나 이어 작업)
    match /star_picking/{gid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 200 * 1024 * 1024;   // 세트 하나당 200MB 이내
      allow delete: if request.auth != null;
    }
    // 정산 파일함(settlement.html) — 원본 엑셀을 2차 비밀번호 키로 암호화한 암호문만 올라온다.
    // Storage 규칙은 DB 의 superadmins 를 못 읽으므로 슈퍼관리자 uid 를 직접 적는다.
    // (슈퍼관리자가 바뀌면 여기와 DB superadmins 를 함께 고칠 것)
    match /settlement/{ym}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid in ['W0qRl4dKWge735goslFl4f2B5Sv2'];
      allow write: if request.auth != null && request.auth.uid in ['W0qRl4dKWge735goslFl4f2B5Sv2']
                   && request.resource.size < 300 * 1024 * 1024;   // 파일당 300MB 이내
    }
    // 그 외 경로는 모두 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
