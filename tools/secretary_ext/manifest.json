{
  "manifest_version": 3,
  "name": "메이크창고 비서",
  "version": "1.1.0",
  "description": "메이크창고 전담비서 전용 크롬에서 헤드비서 탭을 유지하고, 비서가 연 탭에 도우미를 켭니다.",
  "minimum_chrome_version": "111",
  "permissions": ["alarms", "tabs"],
  "host_permissions": ["https://makewon.com/*", "https://service.epost.go.kr/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.ezadmin.co.kr/*", "https://ebut3pl.co.kr/*", "https://*.ebut3pl.co.kr/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://makewon.com/secretary.html*"],
      "js": ["mark.js"],
      "run_at": "document_start"
    }
  ]
}
